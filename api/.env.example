# Copy to .env and adjust. Never commit a real .env.
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
ENV=dev

# Phase 1 — unused in Phase 0 (Supabase project does not exist yet;
# auth is a clearly-marked stub, see docs/DECISIONS.md).
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Phase 2 — training execution (persistent runtime state; never committed).
RUSTENWER_DATA_DIR=api/data
TRAINING_MAX_WORKERS=2
LOCAL_RATE_USD_PER_HOUR=0.02

# Phase 2 — DigitalOcean GPU provider (code-complete, credential-blocked:
# without DO_TOKEN the provider refuses instead of faking execution).
DO_TOKEN=
DO_REGION=nyc3
DO_GPU_SIZE=gpu-rtx4000x1-20gb
DO_SSH_KEY_IDS=
DO_SSH_PRIVATE_KEY=
